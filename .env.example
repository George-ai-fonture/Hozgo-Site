# Base URL of the HOZGO web app. Used for "Get the app" and sign-in links. Defaults to https://hozgo.co.uk
VITE_APP_URL=https://hozgo.co.uk
# Supabase project URL (only needed if the quote form writes directly to Supabase)
VITE_SUPABASE_URL=
# Supabase anon (public) key. Never put a service role key here.
VITE_SUPABASE_ANON_KEY=
# Optional HTTPS endpoint that receives quote and transporter leads as JSON POST
VITE_LEAD_ENDPOINT=
